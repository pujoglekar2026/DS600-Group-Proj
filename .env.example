# Copy this file to .env and fill in the values. Never commit .env to GitHub.

# A long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# --- Database -------------------------------------------------------------
# Leave DB_HOST empty to use a local SQLite file (good for development).
# On AWS, set these to your Amazon RDS MySQL endpoint and credentials.
DB_HOST=
DB_PORT=3306
DB_NAME=nimbus
DB_USER=admin
DB_PASSWORD=

# --- Market data ----------------------------------------------------------
# yahoo = live data via yfinance; demo = synthetic data that works offline.
MARKET_DATA_PROVIDER=yahoo
# If Yahoo fails (rate limits are common from cloud IPs), fall back to demo
# data instead of showing an error. The page shows a banner when this happens.
DEMO_FALLBACK=true
# Seconds to cache market data in memory.
CACHE_TTL=900
